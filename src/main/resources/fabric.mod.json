{
  "schemaVersion": 1,
  "id": "hypershot",
  "version": "${version}",
  "name": "HyperShot",
  "description": "Memory-safe extreme-resolution screenshots, tiled rendering, previews, metadata, and an indexed in-game gallery.",
  "authors": ["Adrien"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/hypershot/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.hypershot.HyperShotClient"],
    "modmenu": ["dev.hypershot.compat.HyperShotModMenuApi"]
  },
  "mixins": ["hypershot.client.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "modmenu": ">=20.0.1"
  },
  "custom": {
    "modmenu": {
      "update_checker": false
    }
  }
}
